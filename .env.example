# Server-side env vars for the /api/send-order serverless function.
# Set these in Vercel -> Project Settings -> Environment Variables.
# For local testing, copy to .env.local and run `vercel dev`.

# Gmail account that sends the order emails
GMAIL_USER=slazete.orders@gmail.com

# 16-char App Password for that account (Google Account -> Security ->
# 2-Step Verification -> App passwords). NOT the normal Gmail password.
GMAIL_APP_PASSWORD=

# Inbox that receives the orders
ORDER_TO_EMAIL=slazete@gmail.com
